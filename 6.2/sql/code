
USE HRMDB;

CREATE TABLE PhongBan
(
    MaPB INT IDENTITY(1,1) PRIMARY KEY,
    TenPB NVARCHAR(100) NOT NULL,
    Mota NVARCHAR(255)
);

CREATE TABLE NhanVien
(
    MaNV INT IDENTITY(1,1) PRIMARY KEY,
    HoTen NVARCHAR(100) NOT NULL,
    NgaySinh DATETIME,
    CCCD VARCHAR(20) UNIQUE,
    MaPB INT,
    LuongCoBan DECIMAL(18,2) CHECK (LuongCoBan > 0),
    HeSoLuong FLOAT DEFAULT 1.0,

    CONSTRAINT FK_NhanVien_PhongBan
    FOREIGN KEY (MaPB) REFERENCES PhongBan(MaPB)
);

CREATE TABLE BangChamCong
(
    MaCong INT IDENTITY(1,1) PRIMARY KEY,
    MaNV INT NOT NULL,
    ThangNam VARCHAR(7) NOT NULL,
    SoNgayCong FLOAT NOT NULL DEFAULT 0
        CHECK (SoNgayCong >= 0 AND SoNgayCong <= 31),
    SoGioOT FLOAT DEFAULT 0
        CHECK (SoGioOT >= 0),
    DaChot BIT NOT NULL DEFAULT 0,

    CONSTRAINT FK_BangChamCong_NhanVien
    FOREIGN KEY (MaNV) REFERENCES NhanVien(MaNV),

    CONSTRAINT UQ_BangChamCong
    UNIQUE (MaNV, ThangNam)
);

CREATE TABLE BangLuong
(
    MaLuong INT IDENTITY(1,1) NOT NULL UNIQUE,
    MaNV INT NOT NULL,
    ThangNam VARCHAR(7) NOT NULL,
    ThucLinh DECIMAL(18,2) NOT NULL,

    CONSTRAINT PK_BangLuong
    PRIMARY KEY (MaNV, ThangNam),

    CONSTRAINT FK_BangLuong_NhanVien
    FOREIGN KEY (MaNV) REFERENCES NhanVien(MaNV)
);






USE HRMDB;

CREATE TRIGGER TR_KhoaChamCong
ON BangChamCong
AFTER UPDATE, DELETE
AS
BEGIN
    IF EXISTS
    (
        SELECT 1
        FROM deleted
        WHERE DaChot = 1
    )
    BEGIN
        RAISERROR(
            N'Bang cham cong da chot luong, khong duoc phep sua hoac xoa!',
            16,
            1
        );

        ROLLBACK TRANSACTION;
        RETURN;
    END
END;
